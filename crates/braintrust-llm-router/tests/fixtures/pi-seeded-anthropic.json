{
  "model": "claude-opus-5-5",
  "messages": [
    {
      "role": "user",
      "content": "Seeded context."
    },
    {
      "role": "user",
      "content": [
        {
          "type": "text",
          "text": "Say OK."
        }
      ]
    },
    {
      "role": "system",
      "content": [
        {
          "type": "text",
          "text": "Updated system prompt section \"preamble\":\n\nUse the supplied tools.\n\nUpdated system prompt section \"cwd\":\n\n<cwd>\n/\n</cwd>",
          "cache_control": {
            "type": "ephemeral"
          }
        }
      ]
    },
    {
      "role": "system",
      "content": [],
      "output_config": {
        "effort": "high"
      }
    }
  ],
  "max_tokens": 128000,
  "stream": true,
  "tools": [
    {
      "name": "echo",
      "description": "Return input.",
      "eager_input_streaming": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "tool_search",
      "description": "# Tool discovery\n\nSearches over deferred tool metadata with BM25 and exposes matching tools for the next model call.\n\nSome of the tools, such as tools of MCP servers, may not have been provided to you upfront, and you should use this tool (`tool_search`) to search for the required tools. For MCP tool discovery, always use `tool_search`.",
      "eager_input_streaming": true,
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Search query for deferred tools."
          },
          "limit": {
            "type": "number",
            "description": "Maximum number of tools to return. Defaults to 8."
          }
        },
        "required": [
          "query"
        ]
      },
      "cache_control": {
        "type": "ephemeral"
      }
    }
  ],
  "thinking": {
    "type": "adaptive",
    "display": "summarized",
    "block_binding": {
      "prefix_mismatch_behavior": "drop_block"
    }
  },
  "output_config": {
    "effort": "high"
  }
}
